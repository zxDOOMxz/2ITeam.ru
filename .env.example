# Контактные данные компании (используются в шапке, подвале и на странице контактов)
VITE_COMPANY_NAME=2ITeam
VITE_CONTACT_PHONE=+7 (915) 180-57-49
VITE_CONTACT_EMAIL=support@2iteam.ru

# MAX: ссылка и подпись для отображения на сайте.
# Личный профиль: https://max.ru/u/<id> (берётся в профиле через QR-код).
# Группа:          https://max.ru/join/<токен>.
# VITE_CONTACT_MAX_URL имеет приоритет. VITE_CONTACT_MAX используется только для
# автоссылки https://max.ru/<имя>, если VITE_CONTACT_MAX_URL не задан.
VITE_CONTACT_MAX_URL=https://max.ru/u/f9LHodD0cOJg-Zm1q3iLa7uTmfUgKta-NZ5rSLoaWnS26314NxPXZzCpc7g
VITE_CONTACT_MAX_TITLE=Написать в MAX
VITE_CONTACT_MAX=2iteam

# Приём заявок. Укажите один из вариантов.

# 1) Чат-бот MAX: создайте бота на платформе https://business.max.ru/self,
#    получите access_token. Для отправки в чат нужен chat_id, в личку — user_id
#    (узнать можно через подписку на события: POST /subscriptions или GET /updates).
#    ВНИМАНИЕ: токен в клиентском бандле виден пользователям, а запросы к API MAX
#    из браузера могут блокироваться CORS. Для публичного продакшена используйте
#    backend-прокси (см. VITE_FORM_ENDPOINT).
VITE_MAX_BOT_TOKEN=
VITE_MAX_CHAT_ID=
VITE_MAX_USER_ID=

# 2) Почта через Web3Forms (по умолчанию).
#    Получите Access Key на https://web3forms.com, указав support@2iteam.ru —
#    ключ придёт на почту. Ключ публичный, хранить его в секрете не нужно.
#    Пока ключ не задан, форма откроет почтовый клиент посетителя (mailto).
VITE_FORM_ENDPOINT=https://api.web3forms.com/submit
VITE_WEB3FORMS_KEY=

#    Любой другой обработчик (Formspree, Getform, свой backend): впишите его URL
#    в VITE_FORM_ENDPOINT. Поле access_key добавляется только для web3forms.com.

# Личный кабинет (Supabase). Project URL и anon/publishable ключ — публичные.
VITE_SUPABASE_URL=https://hwdsgmvxoljhswlbasqr.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_5FYgn18h_ipErr9sBBuc2w_FCgLiZb3

# Реквизиты исполнителя для закрывающих документов (актов).
VITE_EXECUTOR_NAME=2ITeam
VITE_EXECUTOR_LEGAL_NAME=
VITE_EXECUTOR_INN=
VITE_EXECUTOR_KPP=
VITE_EXECUTOR_OGRN=
VITE_EXECUTOR_ADDRESS=
